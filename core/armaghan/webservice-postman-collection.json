								"rest",
								"getMessageState"
							]
						},
						"description": "<p><b>NOTE: </b><span>if the referenceId is <b>NULL</b>, you will get <b>NULL</b>.</span></p>\n<p><b>NOTE: </b><span>if the referenceId is <b>not found</b>, you will get <b>-100</b> in state.</span></p>\n<h4>Message States:</h4>\n<ul>\n    <li><b><i>0</i></b> => <b><i>scheduled</i></b></li>\n    <li><b><i>1</i></b> => <b><i>sent</i></b></li>\n    <li><b><i>2</i></b> => <b><i>delivered</i></b></li>\n    <li><b><i>3</i></b> => <b><i>not delivered</i></b></li>\n    <li><b><i>4</i></b> => <b><i>unknown</i></b></li>\n    <li><b><i>5</i></b> => <b><i>ready</i></b></li>\n    <li><b><i>6</i></b> => <b><i>canceled</i></b></li>\n</ul>"
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\r\n    \"username\":\"{{username}}\",\r\n    \"password\":\"{{password}}\",\r\n    \"ids\": [123456789123456789]\r\n}",
									"options": {
										"raw": {
