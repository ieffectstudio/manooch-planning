			"item": [
				{
					"name": "ReceiveIncomingMessages",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"username\":\"{{username}}\",\r\n    \"password\":\"{{password}}\",\r\n    \"page\": 0,\r\n    \"size\": 100,\r\n    \"afterId\": 0,\r\n    \"from\": 0,\r\n    \"to\": 0,\r\n    \"destination\": {{originator}},\r\n    \"originator\": {{sample_destination}},\r\n    \"content\": \"{{sample_text}}\",\r\n    \"serviceTag\": \"12345\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/webservice/rest/getReceivedMessages",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"webservice",
								"rest",
								"getReceivedMessages"
							]
						},
						"description": "<ul>\n    <li>The only required input variables are <b><i>username</i></b> and <b><i>password</i></b>.</li>\n    <li>Variables <b><i>from</i></b> and <b><i>to</i></b> are unix timestamp in milli seconds.</li>\n    <li>This list API is paginated. <b><i>page</i></b> is zero-based and defaulted to 0. <b><i>size</i></b> is the length of the result and defaulted to 100.</li>\n    <li>when setting <b><i>afterId</i></b> in request, results are after the specified id.</li>\n    <li><b><i>originator</i></b> is the mobile number the message is sent from.</li>\n    <li><b><i>destination</i></b> is the number the message is sent to. for example it may start with 50004.</li>\n    <li>you can also search messages based on <b><i>content</i></b>. Be aware that the search is not based on words. For example, if you search \"ab\", messages containing \"xxabxx\" are also shown.</li>\n    <li>if you want to get incoming messages for a specific service, you can add its tag to <b><i>serviceTag</i></b>.</li>\n</ul>"
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\r\n    \"username\":\"sample_user\",\r\n    \"password\":\"password_1234\"\r\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/webservice/rest/getReceivedMessages",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"webservice",
										"rest",
										"getReceivedMessages"
									]
								}
							},
							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [],
							"cookie": [],
							"body": "{\r\n    \"errorModel\": {\r\n        \"errorCode\": 0,\r\n        \"message\": null,\r\n        \"timestamp\": null\r\n    },\r\n    \"result\": {\r\n        \"recordsTotal\": 1,\r\n        \"recordsFiltered\": 1,\r\n        \"data\": [\r\n            {\r\n                \"id\": 1,\r\n                \"content\": \"test message\",\r\n                \"destination\": 50004123456789,\r\n                \"originator\": 9112223344,\r\n                \"insertDate\": 0\r\n            }\r\n        ]\r\n    }\r\n}"
						}
					]
