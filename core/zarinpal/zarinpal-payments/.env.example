# dummy | sandbox | production
ZARINPAL_MODE=dummy

# 36-char UUID from ZarinPal panel (any 36 chars for dummy/sandbox)
ZARINPAL_MERCHANT_ID=c3e83cb7-e3ca-4a18-8836-64e8191bfec9

# IRT = toman, IRR = rial. Must match what you display to users.
ZARINPAL_CURRENCY=IRT

# Public base URL. In production must be https and match the domain
# registered for this gateway in the panel, or you get error -14.
APP_URL=http://localhost:3000
PORT=3000
